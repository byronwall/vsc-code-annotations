{
    "name": "vsc-code-annotations",
    "displayName": "Code Annotations",
    "description": "Capture code selections as markdown annotations for later AI-assisted implementation work",
    "version": "0.0.5",
    "publisher": "byronwall",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/byronwall/vsc-code-annotations.git"
    },
    "icon": "assets/icon.png",
    "galleryBanner": {
        "color": "#18333A",
        "theme": "dark"
    },
    "keywords": [
        "annotations",
        "code-comments",
        "ai",
        "markdown",
        "workspace"
    ],
    "pricing": "Free",
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codeAnnotations.addAnnotation",
                "category": "Code Annotations",
                "title": "Add Annotation",
                "icon": "$(comment-add)"
            },
            {
                "command": "codeAnnotations.fixAnnotationLocation",
                "category": "Code Annotations",
                "title": "Fix Annotation Code Ref",
                "icon": "$(wrench)"
            },
            {
                "command": "codeAnnotations.openAnnotationsSidebar",
                "category": "Code Annotations",
                "title": "Open Annotations Sidebar",
                "icon": "$(list-tree)"
            },
            {
                "command": "codeAnnotations.openAnnotationsDocument",
                "category": "Code Annotations",
                "title": "Open Annotations Document",
                "icon": "$(go-to-file)"
            },
            {
                "command": "codeAnnotations.refresh",
                "category": "Code Annotations",
                "title": "Refresh Annotations",
                "icon": "$(refresh)"
            },
            {
                "command": "codeAnnotations.toggleSidebarGroupingMode",
                "category": "Code Annotations",
                "title": "Toggle Sidebar Grouping",
                "icon": "$(list-tree)"
            },
            {
                "command": "codeAnnotations.expandAnnotationsTree",
                "category": "Code Annotations",
                "title": "Expand All Annotation Groups",
                "icon": "$(expand-all)"
            },
            {
                "command": "codeAnnotations.collapseAnnotationsTree",
                "category": "Code Annotations",
                "title": "Collapse Annotation Groups",
                "icon": "$(collapse-all)"
            },
            {
                "command": "codeAnnotations.createAnnotationList",
                "category": "Code Annotations",
                "title": "New Annotation List",
                "icon": "$(add)"
            },
            {
                "command": "codeAnnotations.setActiveAnnotationList",
                "category": "Code Annotations",
                "title": "Set Active Annotation List",
                "icon": "$(star-full)"
            },
            {
                "command": "codeAnnotations.openAnnotationDocumentLocation",
                "category": "Code Annotations",
                "title": "Open Annotation In List",
                "icon": "$(go-to-file)"
            },
            {
                "command": "codeAnnotations.deleteAnnotation",
                "category": "Code Annotations",
                "title": "Delete Annotation",
                "icon": "$(trash)"
            }
        ],
        "keybindings": [
            {
                "command": "codeAnnotations.addAnnotation",
                "key": "ctrl+shift+0",
                "mac": "cmd+shift+0",
                "when": "editorTextFocus"
            },
            {
                "command": "codeAnnotations.addAnnotation",
                "key": "ctrl+shift+numpad0",
                "mac": "cmd+shift+numpad0",
                "when": "editorTextFocus"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codeAnnotations",
                    "title": "Annotations",
                    "icon": "$(comment-discussion)"
                }
            ]
        },
        "views": {
            "codeAnnotations": [
                {
                    "id": "codeAnnotations.annotations",
                    "name": "Workspace Annotations",
                    "icon": "assets/icon.png"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "codeAnnotations.openAnnotationsDocument",
                    "icon": "$(go-to-file)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@1"
                },
                {
                    "command": "codeAnnotations.addAnnotation",
                    "icon": "$(comment-add)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@1"
                },
                {
                    "command": "codeAnnotations.createAnnotationList",
                    "icon": "$(add)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@1"
                },
                {
                    "command": "codeAnnotations.refresh",
                    "icon": "$(refresh)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@2"
                },
                {
                    "command": "codeAnnotations.toggleSidebarGroupingMode",
                    "icon": "$(list-tree)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@2"
                },
                {
                    "command": "codeAnnotations.expandAnnotationsTree",
                    "icon": "$(expand-all)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@2"
                },
                {
                    "command": "codeAnnotations.collapseAnnotationsTree",
                    "icon": "$(collapse-all)",
                    "when": "view == codeAnnotations.annotations",
                    "group": "navigation@2"
                }
            ],
            "editor/context": [
                {
                    "command": "codeAnnotations.addAnnotation",
                    "when": "editorTextFocus",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "codeAnnotations.setActiveAnnotationList",
                    "icon": "$(star-full)",
                    "when": "view == codeAnnotations.annotations && viewItem == annotationListInactive",
                    "group": "inline@1"
                },
                {
                    "command": "codeAnnotations.openAnnotationDocumentLocation",
                    "icon": "$(go-to-file)",
                    "when": "view == codeAnnotations.annotations && (viewItem == annotationEntryCurrent || viewItem == annotationEntryRelocated || viewItem == annotationEntryMissing)",
                    "group": "inline@1"
                },
                {
                    "command": "codeAnnotations.fixAnnotationLocation",
                    "icon": "$(wrench)",
                    "when": "view == codeAnnotations.annotations && viewItem == annotationEntryRelocated",
                    "group": "inline@2"
                },
                {
                    "command": "codeAnnotations.deleteAnnotation",
                    "icon": "$(trash)",
                    "when": "view == codeAnnotations.annotations && (viewItem == annotationEntryCurrent || viewItem == annotationEntryRelocated || viewItem == annotationEntryMissing)",
                    "group": "inline@3"
                }
            ]
        },
        "configuration": {
            "title": "Code Annotations",
            "properties": {
                "codeAnnotations.sidebarGroupingMode": {
                    "type": "string",
                    "enum": [
                        "flat",
                        "file"
                    ],
                    "enumDescriptions": [
                        "Show annotations as a flat list inside each annotation list.",
                        "Group annotations by workspace file using a folder tree inside each annotation list."
                    ],
                    "default": "flat",
                    "scope": "application",
                    "description": "Controls how annotations are grouped in the sidebar. This is a global user setting."
                },
                "codeAnnotations.documentPath": {
                    "type": "string",
                    "default": ".annotations/code-annotations.md",
                    "description": "Workspace-relative markdown file used to store saved code annotations. Paths recorded inside it are repo-relative to the workspace root."
                }
            }
        },
        "languageModelTools": [
            {
                "name": "create_code_annotation",
                "displayName": "Create Code Annotation",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "create-annotation",
                "icon": "$(comment-add)",
                "userDescription": "Create one annotation entry in the workspace annotations markdown file.",
                "modelDescription": "Create a single code annotation in this workspace by appending a canonical entry to the active annotation list or to a named list. Use this when a review identifies one specific issue, follow-up, question, idea, or context note tied to a file or a line range. The tool converts absolute file paths into repo-relative paths, derives the stored code snippet from the current file contents for selection annotations, and stores whole-file annotations with an empty code block. Do not use this for reading annotations or for creating many annotations at once.",
                "when": "workspaceFolderCount > 0",
                "inputSchema": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "listName": {
                            "type": "string",
                            "description": "Optional annotation list name. When omitted, the active annotation list for the workspace is used."
                        },
                        "createListIfMissing": {
                            "type": "boolean",
                            "description": "If true and listName does not exist yet, create a new annotation list markdown file for that name."
                        },
                        "filePath": {
                            "type": "string",
                            "description": "Absolute path to the workspace file that should be annotated."
                        },
                        "startLine": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "1-based inclusive start line for a selection annotation. Omit this and endLine for a whole-file annotation unless scope is explicitly set to file."
                        },
                        "endLine": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "1-based inclusive end line for a selection annotation. Defaults to startLine when omitted."
                        },
                        "scope": {
                            "type": "string",
                            "enum": [
                                "selection",
                                "file"
                            ],
                            "description": "Use selection to annotate a specific line range, or file to annotate the whole file. If omitted, the extension infers file when no line numbers are provided and selection otherwise."
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "follow-up",
                                "issue",
                                "question",
                                "idea",
                                "context"
                            ],
                            "description": "Annotation category. Choose the smallest accurate type for the review finding."
                        },
                        "comment": {
                            "type": "string",
                            "description": "Markdown comment body stored in the annotation's Comment section. Include the review finding, rationale, and next step."
                        }
                    },
                    "required": [
                        "filePath",
                        "type",
                        "comment"
                    ]
                }
            },
            {
                "name": "create_code_annotations",
                "displayName": "Create Code Annotations",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "create-annotations",
                "icon": "$(list-selection)",
                "userDescription": "Create multiple annotation entries in one call, typically from a code review.",
                "modelDescription": "Create many code annotations in one call, usually for a review or audit that produced several findings. Use this when you have a batch of file locations and comments that should all be written into the workspace annotations markdown format. The tool validates every target file and line range first, then appends the canonical annotation blocks to the active list or to a named list, creating that list if requested. Prefer this tool over repeated single-annotation calls when recording a thorough review.",
                "when": "workspaceFolderCount > 0",
                "inputSchema": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "listName": {
                            "type": "string",
                            "description": "Optional annotation list name. When omitted, the active annotation list for each workspace is used."
                        },
                        "createListIfMissing": {
                            "type": "boolean",
                            "description": "If true and listName does not exist yet, create a new annotation list markdown file for that name."
                        },
                        "annotations": {
                            "type": "array",
                            "minItems": 1,
                            "description": "The annotations to create. Use one item per review finding.",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "filePath": {
                                        "type": "string",
                                        "description": "Absolute path to the workspace file that should be annotated."
                                    },
                                    "startLine": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "1-based inclusive start line for a selection annotation. Omit this and endLine for a whole-file annotation unless scope is explicitly set to file."
                                    },
                                    "endLine": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "1-based inclusive end line for a selection annotation. Defaults to startLine when omitted."
                                    },
                                    "scope": {
                                        "type": "string",
                                        "enum": [
                                            "selection",
                                            "file"
                                        ],
                                        "description": "Use selection to annotate a specific line range, or file to annotate the whole file. If omitted, the extension infers file when no line numbers are provided and selection otherwise."
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "follow-up",
                                            "issue",
                                            "question",
                                            "idea",
                                            "context"
                                        ],
                                        "description": "Annotation category. Choose the smallest accurate type for the review finding."
                                    },
                                    "comment": {
                                        "type": "string",
                                        "description": "Markdown comment body stored in the annotation's Comment section. Include the review finding, rationale, and next step."
                                    }
                                },
                                "required": [
                                    "filePath",
                                    "type",
                                    "comment"
                                ]
                            }
                        }
                    },
                    "required": [
                        "annotations"
                    ]
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run compile",
        "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
        "typecheck": "tsc -p ./ --noEmit",
        "compile": "pnpm run typecheck && pnpm run bundle:extension",
        "watch": "tsc -watch -p ./",
        "package:vsix": "pnpm run compile && vsce package --allow-missing-repository --no-dependencies -o vsc-code-annotations.vsix",
        "publish:vsix": "vsce publish --allow-missing-repository --packagePath vsc-code-annotations.vsix",
        "publish:patch": "pnpm run compile && vsce publish patch --allow-missing-repository --no-dependencies",
        "publish:minor": "pnpm run compile && vsce publish minor --allow-missing-repository --no-dependencies",
        "install:vsix": "code --install-extension vsc-code-annotations.vsix --force",
        "build:install": "pnpm run package:vsix && pnpm run install:vsix",
        "dev:host": "code --extensionDevelopmentPath=$PWD $PWD"
    },
    "devDependencies": {
        "@types/node": "^22.10.1",
        "@types/vscode": "^1.95.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.27.4",
        "typescript": "^5.7.2"
    }
}
